# Browser-safe values (bundled into the site).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values for Netlify Functions. Add these in Netlify:
# Site configuration → Environment variables. Never prefix them with VITE_
# and never commit real values. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are
# optional; the functions fall back to the VITE_ values above.
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY is accepted instead of SUPABASE_SECRET_KEY.
