# ── Website (browser-safe; bundled into the site) ───────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Only when the API is on a different domain than the site (no trailing slash).
# VITE_API_BASE_URL=https://api.imanlogistics.com

# ── API server (server/) — server-only, never prefix with VITE_ ─────────────
PORT=3001
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY is accepted instead of SUPABASE_SECRET_KEY.
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY default to the VITE_ values above.

# Public site origin: Stripe return URLs and password-reset links.
APP_URL=https://imanlogistics.com
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://imanlogistics.com

# Stripe (same setup as the Iman Trucking School site). Leave empty to take
# bookings without online payment.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (Resend) and SMS (Twilio) for Freight Broker Masterclass registrations,
# same setup as the school's dispatcher registration. Each channel is skipped
# (and logged as skipped) until configured.
RESEND_API_KEY=
FREIGHT_BROKER_EMAIL_FROM=Iman Logistics <info@imanlogistics.com>
# Staff inbox (and optional phone) notified of every paid registration.
# ADMIN_NOTIFICATION_EMAIL / ADMIN_NOTIFICATION_PHONE (the school's names) also work.
FREIGHT_BROKER_NOTIFY_EMAIL=info@imanlogistics.com
FREIGHT_BROKER_NOTIFY_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Random 32+ byte secret used to hash registration OTPs and verification grants.
VERIFICATION_CODE_SECRET=replace_with_a_long_random_secret

# Optional
# SWAGGER_ENABLED=true           # show /api/docs when NODE_ENV=production (off by default)
# RATE_LIMIT_SUBMISSIONS=20      # public form posts per IP per 15 minutes
