# Iman Logistics website + API in one container (same process as on Hostinger).
# Build: docker build -f Dockerfile.api -t iman-logistics .
# Run:   docker run --env-file .env -p 3001:3001 iman-logistics
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3001
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY --from=build /app/server/dist ./server/dist
COPY server.js ./
USER node
EXPOSE 3001
CMD ["node", "server.js"]
