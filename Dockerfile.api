# Iman Logistics API (server/). Build: docker build -f Dockerfile.api -t iman-api .
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server ./server
COPY src/features/consultation/serviceCatalog.ts ./src/features/consultation/serviceCatalog.ts
RUN npm run build:api

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3001
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/server/dist ./server/dist
USER node
EXPOSE 3001
CMD ["node", "server/dist/index.js"]
